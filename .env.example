# Campus Pulse Environment Configuration

# 1. Google Gemini API Key (Server-side)
# Get your free key at: https://aistudio.google.com/app/apikey
# If left empty, Campus Pulse automatically runs in Intelligent Demo Mode with zero errors.
GEMINI_API_KEY=

# 2. Supabase Integration (Optional - App falls back seamlessly to LocalStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
